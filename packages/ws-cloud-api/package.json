{
  "name": "ws-cloud-api",
  "version": "0.18.0-alpha",
  "description": "WhatsApp Cloud API for NodeJS",
  "keywords": [
    "api",
    "cloud",
    "media",
    "messaging",
    "nodejs",
    "webhook",
    "whatsapp"
  ],
  "homepage": "https://ws-cloud-api.lexuil.com/",
  "author": {
    "name": "Lexuil",
    "email": "lexuil.dev@gmail.com",
    "url": "https://lexuil.github.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lexuil/ws-cloud-api.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "smoke:media": "bun run ./scripts/smoke/media.ts",
    "smoke:messages": "bun run ./scripts/smoke/messages.ts",
    "smoke:templates": "bun run ./scripts/smoke/templates.ts"
  },
  "dependencies": {
    "arktype": "2.2.0",
    "neverthrow": "8.2.0",
    "ofetch": "1.5.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "dotenv": "17.2.3",
    "jiti": "2.6.1",
    "pino": "10.3.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "pino": "^10.1.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    }
  }
}
